#: ../src/develop/blend_gui.c:8198
msgid "maximum (union)"
msgstr "Максимум (объединение)"

#: ../src/develop/blend_gui.c:8198
msgid "maximum"
msgstr "Максимум"

#: ../src/develop/blend_gui.c:8199
msgid ""
"everything any member covers: where members overlap, the stronger one wins"
msgstr ""
"всё, что покрывает любой элемент: там, где элементы перекрываются, побеждает "
