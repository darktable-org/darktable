msgid "only the area every member covers: the weaker one wins"
msgstr ""
"Только область, которую покрывает каждый элемент: побеждает более слабый"

#: ../src/develop/blend_gui.c:8216
msgid "product (smooth intersection)"
msgstr "Продукт (плавное пересечение)"

#: ../src/develop/blend_gui.c:8216
msgid "product"
msgstr "Произведение"

#: ../src/develop/blend_gui.c:8217
msgid ""
"like minimum (intersection), but feathered edges fade together smoothly: "
