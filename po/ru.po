#: ../src/develop/blend_gui.c:8221
msgid "difference"
msgstr "Разница"

#: ../src/develop/blend_gui.c:8222
msgid "the bottom member, minus every member above it"
msgstr "Нижний элемент минус каждый элемент над ним"

#: ../src/develop/blend_gui.c:8225
msgid "exclusion"
msgstr "Исключение"

#: ../src/develop/blend_gui.c:8226
msgid ""
