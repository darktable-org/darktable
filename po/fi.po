msgctxt "modulename"
msgid "display encoding"
msgstr "Näytön koodaus"

#: ../src/iop/globaltonemap.c:97
msgid "global tonemap"
msgstr "Yleinen sävykartoitus"

#: ../src/iop/globaltonemap.c:102
msgid "this module is deprecated. please use the filmic rgb module instead."
msgstr ""
"Tämä moduuli on vanhentunut. Kannattaa käyttää Filmic RGB-moduulia tämän "
"sijaan."

#: ../src/iop/globaltonemap.c:304 ../src/iop/monochrome.c:231
msgid "error: bilateral filter failed to allocate memory, check your RAM usage!"
msgstr ""
"Virhe: kaksipuolinen ohjattu suodin ei saanut varattua muistia, tarkista RAM-"
"muistin käyttö!"

#: ../src/iop/globaltonemap.c:640 ../src/libs/filters/colors.c:313
