#: ../src/develop/blend_gui.c:19193 ../src/develop/blend_gui.c:19225
#: ../src/develop/blend_gui.c:19250 ../src/develop/blend_gui.c:19260
#: ../src/develop/blend_gui.c:19269 ../src/develop/blend_gui.c:19281
msgid "blend"
msgstr "Sekoita"

#: ../src/develop/blend_gui.c:6031
msgid "double-click to undo the edits made since the properties were shown"
msgstr ""
"Kaksoisnapsauta peruuttaaksesi asetusten näytön jälkeen tehdyt muokkaukset."

#: ../src/develop/blend_gui.c:6032
msgid "double-click to reset to 100%"
msgstr "Kaksoisnapsauta palauttaaksesi arvoksi 100%."

#: ../src/develop/blend_gui.c:6033
msgid "double-click to reset to 0"
msgstr "Kaksoisnapsauta palauttaaksesi arvoksi 0%."

#: ../src/develop/blend_gui.c:6056 ../src/develop/blend_gui.c:18212
msgid "shrink or grow"
msgstr "Kutista tai kasvata"

#: ../src/develop/blend_gui.c:6060
msgid ""
"grow (positive) or shrink (negative) this path's outline\n"
"0 restores the outline it grew or shrank from, which a move keeps.\n"
"a size, feather, rotation or node edit makes the current outline\n"
"the new 0\n"
"double-click to reset to 0"
msgstr ""
"Kasvata (positiivinen) tai kutista (negatiivinen) tämän polun ääriviivaa.\n"
"Arvo 0 palauttaa ääriviivan siihen tilaan, josta se on suurennettu tai "
"pienennetty\n"
"jonka siirto säilytää. Koon, häivytyksen tai kierron muokkaus asettaa "
"nykyisen\n"
"ääriviivan uudeksi nollaksi.\n"
"Kaksoisnapsautus palauttaa arvoksi 0."

#: ../src/develop/blend_gui.c:6461 ../src/develop/masks/masks.c:3000
#: ../src/develop/masks/masks.c:3686
#, c-format
msgid "opacity: %.0f%%"
msgstr "Peittävyys: %.0f%%"

#: ../src/develop/blend_gui.c:7170
msgid ""
"disabled: adds nothing to the mask\n"
"click to enable"
msgstr ""
"Pois käytöstä: ei lisää mitään maskiin.\n"
"Napsauta ottaaksesi käyttöön."

#: ../src/develop/blend_gui.c:7173
msgid ""
"soloed: only this is used\n"
"click to disable\n"
"shift+click to clear solo"
msgstr ""
"Yksinään: vain tämä on käytössä.\n"
"Napsauta poistaaksesi käytöstä.\n"
