msgstr "työskentelytilan ICC-väriprofiilit"

#: ../src/iop/colorin.c:2348
msgid "confine Lab values to gamut of RGB color space"
msgstr "Rajoita Lab-arvot RGB-sävyasteikkoon."

#: ../src/iop/colorize.c:71
msgid "colorize"
