msgstr "Liukuvärisuodin | Sininen ND2 (pehmeä)"

#: ../src/iop/graduatednd.c:106
msgid "tinted | brown ND4 (soft)"
msgstr "Liukuvärisuodin | Ruskea ND4 (pehmeä)"

#: ../src/iop/graduatednd.c:137
