msgstr "Puoliharmaasuodin | ND8 (kova)"

#: ../src/iop/graduatednd.c:84
msgid "tinted | orange ND2 (soft)"
msgstr "Liukuvärisuodin | Oranssi ND2 (pehmeä)"

#: ../src/iop/graduatednd.c:87
