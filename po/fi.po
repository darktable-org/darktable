msgstr "Operaattori"

#: ../src/iop/globaltonemap.c:641
msgid "the global tonemap operator"
msgstr "Yleisen sävykartoituksen operaattori."

#: ../src/iop/globaltonemap.c:644
msgid ""
"the bias for tonemapper controls the linearity, the higher the more details "
"in blacks"
msgstr ""
"Vinouma säätää sävykartoituksen lineaarisuutta. Korkeampi arvo tuottaa "
"enemmän yksityiskohtia tummilla varjoalueilla."

#: ../src/iop/globaltonemap.c:648
msgid "the target light for tonemapper specified as cd/m2"
msgstr "Sävykartoituksen kohdekirkkaus, yksikkönä cd/m2."

#: ../src/iop/graduatednd.c:64
