msgstr "Suotimen tummuus aukkoina."

#: ../src/iop/graduatednd.c:1038
#, no-c-format
msgid ""
"hardness of graduation:\n"
"0% = soft, 100% = hard"
msgstr ""
"Puoliharmaasuotimen kovuus:\n"
"0% = pehmeä, 100% = kova"

#: ../src/iop/graduatednd.c:1043
msgid "rotation of filter -180 to 180 degrees"
msgstr "Suotimen kierto ±180°."

#: ../src/iop/graduatednd.c:1056
msgid "select the hue tone of filter"
msgstr "Valitse suotimen sävyn värivivahde."

#: ../src/iop/graduatednd.c:1062
msgid "select the saturation of filter"
msgstr "Valitse suotimen värikylläisyys."

#: ../src/iop/graduatednd.c:1073
#, c-format
msgid "[%s on nodes] change line rotation"
msgstr "[%s solmupisteessä] Muuta viivan kiertoa"

#: ../src/iop/graduatednd.c:1074
#, c-format
msgid "[%s on line] move line"
msgstr "[%s viivassa] Siirrä viivaa"

#: ../src/iop/graduatednd.c:1076
#, c-format
msgid "[%s on line] change density"
msgstr "[%s viivassa] Muuta leveyttä"

#: ../src/iop/graduatednd.c:1078
#, c-format
