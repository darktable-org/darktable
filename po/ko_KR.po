#: ../src/iop/channelmixerrgb.c:1913
#, c-format
msgid ""
"\n"
"<b>Profile quality report: %s</b>\n"
"input ΔE: \tavg. %.2f ; \tmax. %.2f\n"
"WB ΔE: \tavg. %.2f; \tmax. %.2f\n"
"output ΔE: \tavg. %.2f; \tmax. %.2f\n"
"\n"
"<b>Profile data</b>\n"
"illuminant:  \t%.0f K \t%s\n"
"matrix in adaptation space:\n"
"<tt>%+.4f \t%+.4f \t%+.4f\n"
"%+.4f \t%+.4f \t%+.4f\n"
"%+.4f \t%+.4f \t%+.4f</tt>\n"
"\n"
"<b>Normalization values</b>\n"
"exposure compensation: \t%+.2f EV\n"
"black offset: \t%+.4f"
msgstr ""
"\n"
"<b>프로파일 품질 보고서: %s</b>\n"
"입력 ΔE: \t평균. %.2f ; \t최대. %.2f\n"
"화이트 밸런스 ΔE: \t평균. %.2f; \t최대. %.2f\n"
"출력 ΔE: \t평균. %.2f; \t최대. %.2f\n"
"\n"
"<b>프로파일 데이터</b>\n"
"광원:  \t%.0f K \t%s\n"
"적용 공간의 행렬:\n"
"<tt>%+.4f \t%+.4f \t%+.4f\n"
"%+.4f \t%+.4f \t%+.4f\n"
"%+.4f \t%+.4f \t%+.4f</tt>\n"
"\n"
"<b>정규화 값</b>\n"
"노출 보정: \t%+.2f EV\n"
"점정 오프셋: \t%+.4f"

#: ../src/iop/channelmixerrgb.c:1969
#, c-format
