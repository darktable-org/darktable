msgstr "en liste over nøkkelord som kan brukes finnes i brukermanualen."

#: ../build/bin/preferences_gen.h:3349
msgid "position of the image information line"
msgstr "plassering av bildeinformasjon"

#: ../build/bin/preferences_gen.h:3366
msgid "border around image in darkroom mode"
msgstr "ramme rundt bildet i mørkeromsmodus"

#: ../build/bin/preferences_gen.h:3382 ../build/bin/preferences_gen.h:3646
#: ../build/bin/preferences_gen.h:4065 ../build/bin/preferences_gen.h:4688
#: ../build/bin/preferences_gen.h:4758 ../build/bin/preferences_gen.h:5008
