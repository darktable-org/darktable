msgstr "graf"

#: ../src/iop/agx.c:1964
msgid "tone mapping curve"
msgstr "tonetilpasningskurve"

#: ../src/iop/agx.c:1977
msgctxt "section"
msgid "advanced curve parameters"
msgstr "avanserte kurveparametre"

#: ../src/iop/agx.c:1994
msgid ""
"length to keep curve linear above the pivot.\n"
"may clip highlights"
msgstr ""
"hvor lenge kurven skal være lineær over vippepunktet.\n"
"kan klippe høylys"

#: ../src/iop/agx.c:2003
msgid "max linear output power"
msgstr "maksimum lineær ut-styrke"

#: ../src/iop/agx.c:2011
msgid ""
"length to keep curve linear below the pivot.\n"
"may crush shadows"
msgstr ""
"hvor lenge kurven skal være lineær under vippepunktet.\n"
"kan klemme skyggene"

#: ../src/iop/agx.c:2020
msgid "raise for a faded look"
msgstr "løft for et utvasket utseende"

#: ../src/iop/agx.c:2026
msgid ""
"adjusts the gamma automatically, trying to make sure\n"
"the curve always remains S-shaped (given that contrast\n"
"is high enough), so toe and shoulder controls remain effective."
msgstr ""
"justerer gamma automatisk, prøver å sørge for at\n"
"kurven alltid holder seg S-formet (forutsatt at kontrast\n"
"er høy nok), så tå- og skulderkontrollene holder seg effektive."

#: ../src/iop/agx.c:2035
msgid ""
"shifts the representation (but not the output power) of the pivot\n"
"along the y axis of the curve.\n"
"immediate contrast around the pivot is not affected,\n"
"but shadows and highlights are; you may have to counteract it\n"
"with the contrast slider or with toe / shoulder controls."
msgstr ""
"flytter representasjonen (men ikke ut-styrken) til\n"
"vippepunktet langs kurvens y-akse.\n"
"umiddelbar kontrast rundt vippepunktet er ikke påvirket,\n"
"men skygger og høylys er; du må kanskje motvirke det\n"
"med kontrastglideren eller med tå/skulder-kontroller."

#: ../src/iop/agx.c:2046
msgctxt "section"
msgid "input exposure range"
msgstr "eksponeringsområde inn"

#: ../src/iop/agx.c:2054
msgid "relative exposure above mid-gray (white point)"
msgstr "relativ eksponering over middels grå (hvittpunkt)"

#: ../src/iop/agx.c:2055
msgid "pick the white point"
msgstr "velg hvittpunkt"

#: ../src/iop/agx.c:2063
msgid "relative exposure below mid-gray (black point)"
msgstr "relativ eksponering under middels grå (svartpunkt)"

#: ../src/iop/agx.c:2064
msgid "pick the black point"
msgstr "velg svartpunkt"

#: ../src/iop/agx.c:2072 ../src/iop/filmicrgb.c:4418
msgid ""
"symmetrically increase or decrease the computed dynamic range.\n"
"useful to give a safety margin to extreme luminances."
msgstr ""
"utvid eller reduser symmetrisk den beregnede dynamiske spennvidden.\n"
"dette er nyttig for å gi sikkerhetsmargin mot ekstrem luminans."

#: ../src/iop/agx.c:2078 ../src/iop/agx.c:2081 ../src/iop/filmic.c:1514
#: ../src/iop/filmicrgb.c:4424 ../src/iop/profile_gamma.c:640
msgid "auto tune levels"
msgstr "autojuster nivåer"

#: ../src/iop/agx.c:2080
msgid "set black and white relative exposure using the selected area"
msgstr "sett svart og hvit relativ eksponering ved å bruke det valgte området"

#: ../src/iop/agx.c:2081 ../src/iop/agx.c:2089
msgid "exposure range"
msgstr "eksponeringsområde"

#: ../src/iop/agx.c:2087
msgid "read exposure from metadata and exposure module"
msgstr "les eksponering fra metadata og eksponeringsmodulen"

#: ../src/iop/agx.c:2090
msgid "read exposure"
msgstr "les eksponering"

#: ../src/iop/agx.c:2139
msgid "blender-like"
msgstr "som i blender"

#: ../src/iop/agx.c:2141
msgid "unmodified"
msgstr "umodifisert"

#: ../src/iop/agx.c:2285 ../src/iop/sigmoid.c:914 ../src/iop/sigmoid.c:918
msgid "primaries"
msgstr "primærfarger"

#: ../src/iop/agx.c:2285
msgid "color primaries adjustments"
msgstr "justering av primærfarger"

#: ../src/iop/agx.c:2291
msgid ""
"color space primaries to use as the base for below adjustments.\n"
"'export profile' uses the profile set in 'output color profile'."
msgstr ""
"primærfarger i fargerommet som brukes som basis for justeringene nedenfor.\n"
"'eksportprofil' bruker profilen som er valgt i 'fargeprofil ut'."

#: ../src/iop/agx.c:2299
msgid ""
"disable purity adjustments and rotations, only applying the curve.\n"
"note that those adjustments are at the heart of AgX,\n"
"without them the results are almost always going to be worse,\n"
"especially with bright, saturated lights (e.g. LEDs).\n"
"mainly intended to be used for experimenting."
msgstr ""
"deaktiver justering av renhet og rotasjon, bare bruk kurve.\n"
"merk at disse justeringene er hjertet av AgX,\n"
"uten dem blir resultatet nesten alltid verre,\n"
"særlig med sterke, fargemettede lys (som LED-lys).\n"
"hovedsaklig tenkt til bruk som eksperimentering."

#: ../src/iop/agx.c:2307
msgid "reset primaries to a predefined configuration"
msgstr "tilbakestill primærfargene til en forhåndsdefinert innstilling"

#: ../src/iop/agx.c:2309 ../src/iop/agx.c:2315
msgid "reset primaries"
msgstr "nullstill primærfarger"

#: ../src/iop/agx.c:2321
msgctxt "section"
msgid "before tone mapping"
msgstr "før tonetilpasning"

#: ../src/iop/agx.c:2331
msgid "increase to desaturate reds in highlights faster"
msgstr "øk for å desaturere rødt i høylys raskere"

#: ../src/iop/agx.c:2338
msgid "shift the red primary towards yellow (+) or magenta (-)"
msgstr "vri rød primærfarge mot gul (+) eller magenta (-)"

#: ../src/iop/agx.c:2344
msgid "increase to desaturate greens in highlights faster"
msgstr "øk for å desaturere grønt i høylys raskere"

#: ../src/iop/agx.c:2351
msgid "shift the green primary towards cyan (+) or yellow (-)"
msgstr "vri grønn primærfarge mot cyan (+) eller gul (-)"

#: ../src/iop/agx.c:2357
msgid "increase to desaturate blues in highlights faster"
msgstr "øk for å desaturere blått i høylys raskere"

#: ../src/iop/agx.c:2364
msgid "shift the blue primary towards magenta (+) or cyan (-)"
msgstr "vri blå primærfarge mot magenta (+) eller cyan (-)"

#: ../src/iop/agx.c:2370
msgctxt "section"
msgid "after tone mapping"
msgstr "etter tonetilpasning"

#: ../src/iop/agx.c:2375
msgid ""
"completely restore purity, undo all rotations, and hide\n"
"the controls below. uncheck to restore the previous state."
msgstr ""
"gjenopprett renhet fullstendig, gjør om alle rotasjoner og skjul\n"
"kontrollene under. avmerk for å gjenopprette forrige tilstand."

#: ../src/iop/agx.c:2378
msgid "set from above"
msgstr "hent fra over"

#: ../src/iop/agx.c:2380
msgid ""
"set parameters to completely reverse primaries modifications,\n"
"but allow subsequent editing"
msgstr ""
"still parametre til å reversere endring av primærfarger fullstendig,\n"
"men tillat påfølgende redigering"

