#: ../src/imageio/storage/gallery.c:160 ../src/imageio/storage/gallery.c:219
#: ../src/imageio/storage/latex.c:146 ../src/imageio/storage/latex.c:195
#: ../src/libs/import.c:1833 ../src/libs/import.c:1944 ../src/libs/import.c:2002
#: ../src/libs/neural_restore.c:4451 ../src/libs/neural_restore.c:4745
#: ../src/libs/styles.c:458 ../src/lua/preferences.c:678
msgid "select directory"
msgstr "velg mappe"

#: ../build/bin/preferences_gen.h:3813
msgid ""
"this folder (and sub-folders) contains LUT files used by LUT 3D module. "
"(restart required)"
msgstr ""
"denne mappen (og undermapper) inneholder LUT-filer som brukes av LUT 3D-"
"modulen. (krever restart)"

#: ../build/bin/preferences_gen.h:3822
msgid "raster mask files root folder"
msgstr "toppmappe for rastermasker"

#: ../build/bin/preferences_gen.h:3837
msgid ""
"this folder (and sub-folders) contains PFM/PNG files used by the raster mask "
"import module. (restart required)"
msgstr ""
"denne mappen (og undermapper) inneholder PFM/PNG-filer som brukes av modulen "
"for import av rastermasker. (krever omstart)"

#: ../build/bin/preferences_gen.h:3846
msgid "auto-apply pixel workflow defaults"
msgstr "bruk automatisk pikselarbeidsflyt"

# prøv å finne et norsk uttrykk for tone mapper
#: ../build/bin/preferences_gen.h:3855
msgid ""
"selects which workflow will be used by default in the darkroom\n"
"\n"
"<b>scene-referred (sigmoid)</b> modern workflow, fewer tonemapper controls\n"
"\n"
"<b>scene-referred (filmic)</b> modern workflow, more tone mapping controls\n"
"\n"
"<b>scene-referred (AgX)</b> modern workflow, maximum tone mapping control\n"
"\n"
"<b>scene-referred (spektrafilm)</b> modern workflow, the tone mapping done by "
"a simulated film and print\n"
"\n"
"<b>display-referred (legacy)</b> legacy workflow (not recommended)\n"
"\n"
"<b>none</b> do not use a predefined workflow"
msgstr ""
"velger hvilken arbeidsflyt som vil brukes som standard i mørkerommet\n"
"\n"
"<b>scenereferert (sigmoid)</b> moderne arbeidsflyt, færre innstillinger for "
"tonetilpasning\n"
"\n"
"<b>scenereferert (filmic)</b> moderne arbeidsflyt, flere innstillinger for "
"tonetilpasning\n"
"\n"
"<b>scenereferert (AgX)</b> moderne arbeidsflyt, flest innstillinger for "
"tonetilpasning\n"
"\n"
"<b>scenereferert (Spektrafilm)</b> moderne arbeidsflyt, tonetilpasningen "
"gjøres med en simulert film og print\n"
"\n"
"<b>visningsreferert (gammel)</> gammel arbeidsflyt (ikke anbefalt)\n"
"\n"
"<b>ingen</b> ikke bruk en forhåndsdefinert arbeidsflyt"

#: ../build/bin/preferences_gen.h:3864
msgid "auto-apply per camera basecurve presets"
msgstr "bruk kameraspesifikke basiskurver automatisk"

#: ../build/bin/preferences_gen.h:3872
msgid ""
"use the per-camera basecurve by default instead of the generic manufacturer "
"one if there is one available. (restart required)\n"
"this option is taken into account when the \"auto-apply pixel workflow "
"defaults\" is set to \"display-referred\".\n"
"to prevent auto-apply basecurve presets \"auto-apply pixel workflow "
"defaults\" should be set to \"none\""
msgstr ""
"bruk de kameraspesifikke basiskurvene som standard i stedet for de generelle "
"kurvene fra kameraprodusenten hvis tilgjengelig (krever omstart).\n"
"dette alternativet vurderes når \"bruk automatisk pikselarbeidsflyt\" er satt "
"til \"visningsreferert\".\n"
"for å forhindre automatisk bruk av forhåndsdefinerte basiskurver \"bør bruk "
"pikselarbeidsflyt automatisk\" settes til \"ingen\""

#: ../build/bin/preferences_gen.h:3881
msgid "detect monochrome previews"
msgstr "oppdag svart/hvitt forhåndsvisning"

#: ../build/bin/preferences_gen.h:3889
msgid ""
"many monochrome images can be identified via EXIF and preview data. beware: "
"this slows down imports and reading of EXIF data"
msgstr ""
"mange svart/hvitt bilder kan identifiseres via EXIF- og forhåndsvisningsdata. "
"OBS! dette gjør at import og lesing av EXIF-data går saktere"

#: ../build/bin/preferences_gen.h:3898
msgid "show warning messages"
msgstr "vis advarsler"

#: ../build/bin/preferences_gen.h:3906
msgid ""
"display messages in modules to warn beginner users when non-standard and "
"possibly harmful settings are used in the pipeline.\n"
"these messages can be false-positive and should be disregarded if you know "
"what you are doing. this option will hide them all the time."
msgstr ""
"viser beskjeder i moduler for å advare nybegynnere når ikke-standard og mulig "
"skadelige innstillinger brukes.\n"
"disse beskjedene kan være falske positiver og kan ignoreres hvis du vet hva "
"du gjør. deaktivering av denne innstillingen vil alltid skjule dem."

#: ../build/bin/preferences_gen.h:3912
msgid "HDR alignment"
msgstr "HDR innretting"

#: ../build/bin/preferences_gen.h:3922
msgid "auto-align frames when merging HDR brackets"
msgstr "innrett bilder automatisk ved sammenslåing av HDR eksponeringsrekker"

#: ../build/bin/preferences_gen.h:3930
msgid ""
"register and warp exposure brackets onto a reference frame before merging, "
"removing ghosting caused by a shaky tripod or handheld shots.\n"
"only effective when darktable is built with OpenCV."
msgstr ""
"registrer og vri eksponeringsrekker til et referansebilde før sammenslåing og "
"fjerne ghosting forårsaket av et ustøtt stativ eller håndholdte bilder.\n"
"gjelder bare når darktable er kompilert med OpenCV."

#: ../build/bin/preferences_gen.h:3943
msgid "pick the HDR alignment reference automatically"
msgstr "velg HDR innrettingsreferanse automatisk"

#: ../build/bin/preferences_gen.h:3951
msgid ""
"before merging, examine every bracket and align to the one richest in detail "
"instead of the first frame.\n"
"improves alignment when the first exposure is a poor template, at the cost of "
"one extra decode pass over the frames.\n"
"requires auto-align and an OpenCV build."
msgstr ""
"før sammenslåing: undersøk hvert bilde i rekken og innrett til det med mest "
"detaljer i stedet for første bilde.\n"
"forbedrer innrettingen når første eksponering er en dårlig mal, på bekostning "
"av en ekstra runde med dekoding.\n"
"forutsetter automatisk innretting og kompilering med OpenCV."

#: ../build/bin/preferences_gen.h:3964
msgid "alignment detail (proxy scale)"
msgstr "detaljnivå for innretting (proxy-skala)"

#: ../build/bin/preferences_gen.h:3977 ../build/bin/preferences_gen.h:4005
#: ../build/bin/preferences_gen.h:4033
#, c-format
msgid "double click to reset to `%.03f'"
msgstr "dobbeltklikk for å gå tilbake til `%.03f'"

#: ../build/bin/preferences_gen.h:3979
msgid ""
"fraction of the full sensor resolution at which feature detection and "
"alignment are computed.\n"
"higher values find more, more distinctive features (better on repetitive or "
"low-contrast scenes) but cost roughly (scale / 0.5)^2 more time and memory.\n"
"0.5 restores the legacy speed."
msgstr ""
"andel av den totale sensoroppløsningen som brukes når trekkdeteksjon og "
"innretting beregnes.\n"
"høyere verdier finner flere og tydeligere trekk (bedre på gjentakende eller "
"lav-kontrast scener) men koster omtrent (skala / 0.5)² mer tid og minne.\n"
"0.5 gjenoppretter tidligere hastighet."

#: ../build/bin/preferences_gen.h:3992
msgid "shadow lift for feature detection (gamma)"
msgstr "løfting av skygger for trekkdeteksjon (gamma)"

#: ../build/bin/preferences_gen.h:4007
msgid ""
"display-gamma applied to the linear raw before feature detection, to lift "
"shadow detail into the detector's range.\n"
"1.0 disables it. higher values help under-exposed frames but can amplify "
"shadow noise; the percentile stretch already does part of this, so the effect "
"is scene-dependent."
msgstr ""
"visningsgamma lagt på lineær raw før trekkdeteksjon, for å løfte "
"skyggedetaljer inn i detektorens område.\n"
"1.0 deaktiverer den. høyere verdier hjelper undereksponerte bilder men kan "
"forsterke støy i skyggene; persentilskaleringen gjør allerede en del av "
"dette, så effekten er sceneavhengig."

#: ../build/bin/preferences_gen.h:4020
msgid "local contrast for feature detection (CLAHE clip)"
msgstr "lokal kontrast for trekkdeteksjon (CLAHE klipp)"

#: ../build/bin/preferences_gen.h:4035
msgid ""
"clip limit of the local contrast enhancement (CLAHE) applied before feature "
"detection. 0 disables it.\n"
"enabling it (e.g. 2.0) helps detect features on extremely under-exposed "
"frames, but on repetitive textures (façades, railings, foliage) it can change "
"descriptor signatures between exposures and cause mis-alignment, so it is off "
"by default."
msgstr ""
"klippgrense for forbedring av lokal kontrast (CLAHE) lagt på før "
"trekkdeteksjon. 0 deaktiverer den.\n"
"aktivering (f. eks. 2.0) hjelper til å oppdage trekk i ekstremt "
"undereksponerte bilder, men på gjentakende teksturer (fasader, gjerder, "
"løvverk) kan den endre beskrivelsessignaturer mellom bilder og forårsake "
"feilinnretting, så den er av som standard."

#: ../build/bin/preferences_gen.h:4048
msgid "feature budget per frame (keypoints)"
msgstr "trekkbudsjett pr bilde (nøkkelpunkter)"

#: ../build/bin/preferences_gen.h:4067
msgid ""
"maximum number of SIFT keypoints kept per frame after spatial balancing, "
"before matching.\n"
"balancing both frames to a common budget keeps a feature-dense frame from "
"flooding the matcher with ambiguous candidates."
msgstr ""
"maksimalt antall SIFT nøkkelpunkter som beholdes etter romlig balansering, "
"før matching.\n"
"balansering av begge bilder til et felles budsjett hindrer et trekkrikt bilde "
"fra å oversvømme matcheren med tvetydige kandidater."

#: ../build/bin/preferences_gen.h:4080
msgid "save alignment debug images"
msgstr "lagre bilder for å feilsøke innretting"

#: ../build/bin/preferences_gen.h:4088
msgid ""
"write per-frame diagnostic images while merging: the feature-detection input, "
"the detected keypoints and all feature matches (green = inlier, red = "
"outlier).\n"
"saved as Netpbm (.pgm/.ppm) in a darktable_hdr_align_debug folder in the "
"system temp directory (or the folder named by the DT_HDR_DEBUG_IMAGE_DIR "
"environment variable). for diagnosing alignment problems; off by default."
msgstr ""
"skriv diagnostikkbilder for hvert bilde under sammenslåing: trekkdeteksjonens "
"input, de detekterte nøkkelpunktene og alle trekkmatcher (grønn = innenfor, "
"rød = utenfor).\n"
"lagret som Netpbm (.pgm/.ppm) i en darktable_hdr_align_debug-mappe i "
"systemets temp-mappe (eller mappen gitt av miljøvariabelen "
"DT_HDR_DEBUG_IMAGE_DIR). for diagnostisering av innrettingsproblemer; av som "
"standard."

#: ../build/bin/preferences_gen.h:4098
msgid "CPU / memory"
msgstr "CPU / minne"

#: ../build/bin/preferences_gen.h:4108
msgid "darktable resources"
msgstr "ressurser for darktable"

#: ../build/bin/preferences_gen.h:4118
#, no-c-format
msgid ""
"defines how much darktable may take from your system resources:\n"
" - 'default': darktable takes ~50% of your systems resources, which is enough "
"to be performant.\n"
" - 'small': should be used if you are simultaneously running applications "
"taking large parts of your systems memory or OpenCL/GL applications like "
"games or Hugin.\n"
" - 'large': is the best option if you are not running other applications at "
"the same time as darktable and want it to take most of your systems resources "
"for performance."
msgstr ""
"definerer hvor mye darktable vil bruke av dine systemressurser.\n"
"- 'standard': darktable tar ca 50% av systemressursene, som er nok til å ha "
"god ytelse.\n"
"- 'lite': bør brukes hvis du samtidig kjører programmer som bruker en stor "
"del av systemressursene eller OpenCL/GL-programmer som spill eller Hugin.\n"
"- 'mye': det beste alternativet hvis du ikke kjører andre programmer samtidig "
"med darktable og vil at det skal bruke størsteparten av systemressursene for "
"bedre ytelse."

#: ../build/bin/preferences_gen.h:4124
msgid "OpenCL GPU acceleration"
msgstr "OpenCL GPU-akselerasjon"

#: ../build/bin/preferences_gen.h:4134
msgid "OpenCL fast mode"
msgstr "OpenCL rask modus"

#: ../build/bin/preferences_gen.h:4142
msgid ""
"if set the OpenCL compiler uses aggressive optimizing for better performance "
"with reduced precision so more differences between CPU and OpenCL are "
"expected."
msgstr ""
"hvis satt bruker OpenCL-kompilatoren aggressiv optimalisering for bedre "
"ytelse med redusert presisjon, så flere forskjeller mellom CPU og OpenCL er "
"forventet."

#: ../build/bin/preferences_gen.h:4155
msgid "OpenCL scheduling profile"
msgstr "OpenCL bruksmønster"

#: ../build/bin/preferences_gen.h:4164
msgid ""
"defines how preview and full pixelpipe tasks are scheduled on OpenCL enabled "
"systems:\n"
" - 'default': GPU processes full and CPU processes preview pipe (adaptable by "
"config parameters),\n"
" - 'multiple GPUs': process both pixelpipes in parallel on two different "
"GPUs,\n"
" - 'very fast GPU': process both pixelpipes sequentially on the GPU."
msgstr ""
"definerer hvordan forhåndsvising og total prosessering vil bli håndtert på "
"maskiner det OpenCL er i bruk.\n"
"- 'standard': GPU håndterer hele bilder og CPU håndterer forhåndsvisning (her "
"kan finjusteringer gjøres via innstillinger),\n"
"- 'flere GPU'er': vil begge prosesseringskjedene håndteres parallelt på ulike "
"GPU'er,\n"
"- 'svært rask GPU': begge prosesseringskjedene håndteres sekvensielt på "
"GPU'en."

#: ../build/bin/preferences_gen.h:4177
msgid "tuned GPU memory"
msgstr "tilpasset GPU-minne"

#: ../build/bin/preferences_gen.h:4185
msgid ""
"if enabled on a system with multiple OpenCL devices you may specify a safety "
"margin per device (headroom, default is 600MB)"
msgstr ""
"hvis aktivert på et system med flere OpenCL-enheter kan du definere en "
"sikkerhetsmargin for hver enhet (takhøyde, standard er 600 MB)"

#: ../build/bin/preferences_gen.h:4195
msgid "OpenCL drivers"
msgstr "OpenCL-drivere"

#: ../build/bin/preferences_gen.h:4205
msgid "Intel GPU"
msgstr "Intel GPU"

#: ../build/bin/preferences_gen.h:4213
msgid "Intel(R) OpenCL Graphics for all supported platforms (vendor provided)"
msgstr ""
"Intel(R) OpenCL-grafikk for alle støttede plattformer (levert av produsent)"

#: ../build/bin/preferences_gen.h:4226
msgid "Nvidia CUDA"
msgstr "Nvidia CUDA"

#: ../build/bin/preferences_gen.h:4234
