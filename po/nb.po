#: ../build/bin/preferences_gen.h:2998
msgid ""
"in the lighttable, where culling takes place, you can apply actions (e.g., "
"setting ratings) to the hovered image or to the selected ones\n"
"\n"
"<b>enabled</b> actions apply to the hovered image (less clicking)\n"
"\n"
"<b>disabled</b> actions apply to the current selection (less error prone)"
msgstr ""
"på lysbordet, under utvelgelse, kan du utføre handlinger (f eks stjernemerke) "
"på bildene under musepekeren eller på de valgte\n"
"\n"
"<b>påslått</b> handlinger utføres på bilder under musepekeren (færre klikk)\n"
"\n"
"<b>avslått</b> handlinger utføres på valgte bilder (mindre risiko for feil)"

#: ../build/bin/preferences_gen.h:3007
msgid "expand a single utility module at a time"
msgstr "utvid en enkelt verktøymodul av gangen"

#: ../build/bin/preferences_gen.h:3015
msgid "this option toggles the behavior of shift clicking in lighttable mode"
msgstr "avgjør hvilken effekt skift+-klikk har i lysbordmodus"

#: ../build/bin/preferences_gen.h:3024
msgid "scroll utility modules to the top when expanded"
msgstr "rull verktøymoduler til toppen når utvidet"

#: ../build/bin/preferences_gen.h:3032 ../build/bin/preferences_gen.h:3545
msgid ""
"when this option is enabled then darktable will try to scroll the module to "
"the top of the visible list"
msgstr "kryss av for å la darktable vise modulen på toppen av listen"

#: ../build/bin/preferences_gen.h:3041
msgid "rating an image one star twice will not zero out the rating"
msgstr "å gi et bilde en stjerne to ganger vil ikke resultere i null stjerner"

#: ../build/bin/preferences_gen.h:3049
msgid "defines whether rating an image one star twice will zero out star rating"
msgstr ""
"definerer om å gi et bilde en stjerne to ganger vil resultere i null stjerner "
"eller ikke"

#: ../build/bin/preferences_gen.h:3058 ../build/bin/preferences_gen.h:3393
msgid "show scrollbars for central view"
msgstr "vis rullefelt for visningen i midten"

#: ../build/bin/preferences_gen.h:3066 ../build/bin/preferences_gen.h:3401
msgid "defines whether scrollbars should be displayed"
msgstr "definerer om rullefeltene skal vises"

#: ../build/bin/preferences_gen.h:3075
msgid "show image time with milliseconds"
msgstr "vis bildetid med millisekunder"

#: ../build/bin/preferences_gen.h:3083
msgid "defines whether time should be displayed with milliseconds"
msgstr "definerer om tidspunkt skal vises med millisekunder"

#: ../build/bin/preferences_gen.h:3089
msgid "thumbnails"
msgstr "småbilder"

#: ../build/bin/preferences_gen.h:3099
msgid "for unaltered images, use raw file instead of embedded JPEG from size"
msgstr ""
"for uendrede bilder, vis raw-fila i stedet for innebygd JPEG fra størrelse"

#: ../build/bin/preferences_gen.h:3108
msgid ""
"if the thumbnail size is greater than this value, it will be processed using "
"raw file instead of the embedded preview JPEG (better but slower).\n"
"if you want all thumbnails and pre-rendered images in best quality you should "
"choose the 'always' option.\n"
"for the quickest display, choose the 'never' option\n"
"the 'auto' option prefers the embedded JPEG except when the thumb size "
"exceeds the resolution of the embedded JPEG\n"
"(more details in the manual)"
msgstr ""
"hvis småbildet er større enn denne verdien vil raw-fila bli brukt i stedet "
"for den innebygde JPEG-fila (bedre men tregere).\n"
"hvis du vil ha alle småbilder og forhåndsrendrede bilder i best kvalitet bør "
"du velge alternativet 'alltid'.\n"
"for den raskeste visningen, velg alternativet 'aldri'.\n"
"alternativet 'auto' foretrekker innebygd JPEG unntatt når småbildestørrelsen "
"overgår oppløsningen av innebygd JPEG.\n"
"(flere detaljer i manualen)"

#: ../build/bin/preferences_gen.h:3117
msgid "high quality processing from size"
msgstr "høykvalitetsprosessering fra størrelse"

#: ../build/bin/preferences_gen.h:3126
msgid ""
"if the thumbnail size is greater than this value, it will be processed using "
"the full quality rendering path (better but slower).\n"
"if you want all thumbnails and pre-rendered images in best quality you should "
"choose the 'always' option.\n"
"(more details in the manual)"
msgstr ""
"hvis småbildet er større enn denne verdien vil det gis full prosessering "
"(tregere prosessering, bedre resultat).\n"
"hvis du vil ha alle småbilder og forhåndsrendrede bilder i best kavalitet bær "
"du velge alternativet 'alltid'.\n"
"(flere detaljer i manualen)"

#: ../build/bin/preferences_gen.h:3135
msgid "enable disk backend for thumbnail cache"
msgstr "bruk disk for mellomlagring av småbilder"

#: ../build/bin/preferences_gen.h:3143
msgid ""
"if enabled, write thumbnails to disk (.cache/darktable/) when evicted from "
"the memory cache.\n"
"note that this can take a lot of memory (several gigabytes for 20k images) "
"and will never delete cached thumbnails again.\n"
"it's safe though to delete these manually, if you want.\n"
"light table performance will be increased greatly when browsing a lot.\n"
"to generate all thumbnails of your entire collection offline, run 'darktable-"
"generate-cache'."
msgstr ""
"hvis aktivert, skriv småbilder til disk (.cache/darktable/) når de flyttes ut "
"av mellomlageret. \n"
"merk at dette kan bruke mye minne (flere gigabytes for 20k bilder) og vil "
"aldri senere fjerne mellomlagrede småbilder. \n"
"det er trygt å slette disse manuelt om ønskelig. \n"
"responsen på lysbordet vil være vesentlig bedre når det blas mye i bilder. \n"
"for å generere småbilder for hele bildesamlingen, kjør 'darktable-generate-"
"cache'."

#: ../build/bin/preferences_gen.h:3152
msgid "enable disk backend for full preview cache"
msgstr "bruk disk for mellomlagring av store bilder"

#: ../build/bin/preferences_gen.h:3160
msgid ""
"if enabled, write full preview to disk (.cache/darktable/) when evicted from "
"the memory cache.\n"
"note that this can take a lot of memory (several gigabytes for 20k images) "
"and will never delete cached full previews again.\n"
"it's safe though to delete these manually, if you want.\n"
"light table performance will be increased greatly when zooming image in full "
"preview mode."
msgstr ""
"hvis aktivert, skriv miniatyrbilder til disk (.cache/darktable/) når de "
"flyttes ut av mellomlageret. \n"
"merk at dette kan bruke mye minne (flere gigabytes for 20k bilder) og vil "
"aldri senere fjerne mellomlagrede miniatyrbilder. \n"
"det er trygt å slette disse manuelt om ønskelig. \n"
"responsen på lysbordet vil være vesentlig bedre når du zoomer i bildet i full "
"forhåndsvisningsmodus."

#: ../build/bin/preferences_gen.h:3169
msgid "enable smooth scrolling for lighttable thumbnails"
msgstr "aktiver jevn rulling for småbilder på lysbordet"

#: ../build/bin/preferences_gen.h:3177
msgid ""
"if enabled, scrolling the lighttable scrolls by some number of pixels, as "
"expected with a touch pad.\n"
"disabled, the lighttable scrolls full rows of thumbnails, as befits a scroll "
"wheel."
msgstr ""
"hvis aktivert vil rulling av lysbordet rulle med et antall piksler, som "
"ventet med en styreplate.\n"
"hvis deaktivert vil lysbordet rulle med hele rader av småbilder, passende for "
"et mushjul."

#: ../build/bin/preferences_gen.h:3186
msgid "generate thumbnails in background"
msgstr "generer småbilder i bakgrunnen"

#: ../build/bin/preferences_gen.h:3195
msgid ""
"if 'enable disk backend for thumbnail cache' is enabled thumbnails/mipmaps up "
"to the selected size are generated while user is inactive in lighttable."
msgstr ""
"hvis 'bruk disk for småbilder' er aktivert vil småbilder opp til den valgte "
"størrelsen bli generert mens brukeren er inaktiv på lysbordet."

#: ../build/bin/preferences_gen.h:3204
msgid "reset cached thumbnails"
msgstr "nullstill mellomlagrede småbilder"

#: ../build/bin/preferences_gen.h:3212
msgid ""
"force thumbnails to be regenerated by resetting the database. this may be "
"needed in case some thumbnails have been manually removed or corrupted."
msgstr ""
"tving småbilder til å bli regenerert ved å nullstille databasen. dette kan "
"være nødvendig hvis noen småbilder har blitt skadet eller manuelt fjernet."

#: ../build/bin/preferences_gen.h:3221
msgid "delimiters for size categories"
msgstr "begrensninger for størrelseskategorier"

#: ../build/bin/preferences_gen.h:3234
msgid ""
"size categories are used to be able to set different overlays and CSS values "
"depending on the size of the thumbnail, separated by |.\n"
"for example, 120|400 means 3 categories of thumbnails: up to 120px, "
"120-400px, more than 400px"
msgstr ""
"størrelseskategorier brukes for å kunne bruke forskjellige overlegg og CSS-"
"verdier avhengig av størrelsen på småbildet, separert av |.\n"
"for eksempel, 120|400 betyr tre kategorier av småbilder: <120px, 120-400px, "
">400px"

#: ../build/bin/preferences_gen.h:3243
msgid "pattern for the thumbnail extended overlay text"
msgstr "mønster for tekst på utvidet småbildeoverlegg"

#: ../build/bin/preferences_gen.h:3258 ../build/bin/preferences_gen.h:3282
msgid "see manual to know all the tags you can use."
msgstr "nøkkelord som kan brukes finnes i brukermanualen."

#: ../build/bin/preferences_gen.h:3267
msgid "pattern for the thumbnail tooltip (empty to disable)"
msgstr "mønster for verktøytips til småbilde (la være tom for å deaktivere)"

#: ../build/bin/preferences_gen.h:3292 ../src/gui/gtk.c:2256
