#: ../src/libs/import.c:1830 ../src/libs/import.c:1941
#: ../src/libs/import.c:1999 ../src/libs/styles.c:456
#: ../src/lua/preferences.c:678
msgid "select directory"
msgstr "qovluq seç"

#: ../build/bin/preferences_gen.h:3822
msgid ""
"this folder (and sub-folders) contains LUT files used by LUT 3D module. "
"(restart required)"
msgstr ""
"bu qovluqda (və alt qovluqlarda) LUT 3D modulunun istifadə etdiyi LUT "
"faylları var. (yenidən başlatmaq tələb olunur)"

#: ../build/bin/preferences_gen.h:3831
msgid "raster mask files root folder"
msgstr "rastr maskası fayllarının kök qovluğu"

#: ../build/bin/preferences_gen.h:3846
msgid ""
"this folder (and sub-folders) contains PFM/PNG files used by the raster mask "
"import module. (restart required)"
msgstr ""
"bu qovluqda (və alt qovluqlarda) rastr maskası idxalı modulunun istifadə "
"etdiyi PFM/PNG faylları var. (yenidən başlatmaq tələb olunur)"

#: ../build/bin/preferences_gen.h:3855
msgid "auto-apply pixel workflow defaults"
msgstr "piksel iş axınının standartlarını avtomatik tətbiq et"

#: ../build/bin/preferences_gen.h:3864
msgid ""
"selects which workflow will be used by default in the darkroom\n"
"\n"
"<b>scene-referred (sigmoid)</b> modern workflow, fewer tonemapper controls\n"
"\n"
"<b>scene-referred (filmic)</b> modern workflow, more tone mapping controls\n"
"\n"
"<b>scene-referred (AgX)</b> modern workflow, maximum tone mapping control\n"
"\n"
"<b>scene-referred (spektrafilm)</b> modern workflow, the tone mapping done "
"by a simulated film and print\n"
"\n"
"<b>display-referred (legacy)</b> legacy workflow (not recommended)\n"
"\n"
"<b>none</b> do not use a predefined workflow"
msgstr ""
"qaranlıq otaqda standart olaraq hansı iş axınının istifadə olunacağını "
"seçir\n\n<b>səhnəyə əsaslanan (siqmoid)</b> müasir iş axını, tonların "
"uyğunlaşdırılması üçün daha az idarəetmə elementi\n"
"\n<b>səhnəyə əsaslanan (fotoplyonka)</b> müasir iş axını, tonların "
"uyğunlaşdırılması üçün daha çox idarəetmə elementi\n"
"\n<b>səhnəyə əsaslanan (AgX)</b> müasir iş axını, tonların "
"uyğunlaşdırılması üçün maksimum idarəetmə imkanı\n"
"\n<b>səhnəyə əsaslanan (spektrafilm)</b> müasir iş axını, tonların "
"uyğunlaşdırılması fotoplyonka və çapın təqlidi vasitəsilə yerinə yetirilir\n"
"\n<b>ekrana əsaslanan (köhnə)</b> köhnə iş axını (tövsiyə edilmir)\n"
"\n<b>heç biri</b> əvvəlcədən müəyyən edilmiş iş axınından istifadə edilmir"

#: ../build/bin/preferences_gen.h:3873
msgid "auto-apply per camera basecurve presets"
msgstr ""
"hər kamera üçün əsas əyrinin hazır parametr dəstlərini avtomatik tətbiq et"

#: ../build/bin/preferences_gen.h:3881
msgid ""
"use the per-camera basecurve by default instead of the generic manufacturer "
"one if there is one available. (restart required)\n"
"this option is taken into account when the \"auto-apply pixel workflow "
"defaults\" is set to \"display-referred\".\n"
"to prevent auto-apply basecurve presets \"auto-apply pixel workflow "
"defaults\" should be set to \"none\""
msgstr ""
"mövcuddursa, istehsalçının ümumi əsas əyrisi əvəzinə standart olaraq "
"kameraya məxsus əsas əyridən istifadə edir. (yenidən başlatmaq tələb "
"olunur)\nbu seçim \"piksel iş axınının standartlarını avtomatik tətbiq et\" "
"parametri \"ekrana əsaslanan\" olaraq təyin edildikdə nəzərə alınır.\n"
"əsas əyrinin hazır parametr dəstlərinin avtomatik tətbiqinin qarşısını "
"almaq üçün \"piksel iş axınının standartlarını avtomatik tətbiq et\" "
"parametrinin \"heç biri\" olaraq təyin edilməsi gərəkdir"

#: ../build/bin/preferences_gen.h:3890
msgid "detect monochrome previews"
msgstr "monoxrom önbaxışları aşkarla"

#: ../build/bin/preferences_gen.h:3898
msgid ""
"many monochrome images can be identified via EXIF and preview data. beware: "
"this slows down imports and reading of EXIF data"
msgstr ""
"bir çox monoxrom şəkil EXIF və önbaxış verilənləri vasitəsilə müəyyən edilə "
"bilər. diqqət: bu, idxalı və EXIF verilənlərinin oxunmasını yavaşladır"

#: ../build/bin/preferences_gen.h:3907
msgid "show warning messages"
msgstr "xəbərdarlıq mesajlarını göstər"

#: ../build/bin/preferences_gen.h:3915
msgid ""
"display messages in modules to warn beginner users when non-standard and "
"possibly harmful settings are used in the pipeline.\n"
"these messages can be false-positive and should be disregarded if you know "
"what you are doing. this option will hide them all the time."
msgstr ""
"emal zəncirində qeyri-standart və zərərli ola biləcək parametrlər istifadə "
"edildikdə yeni istifadəçiləri xəbərdar etmək üçün modullarda mesajlar "
"göstərir.\nbu mesajlar yanlış xəbərdarlıq ola bilər və gördüyü işdən əmin "
"olan istifadəçinin onlara məhəl qoymaması gərəkdir. bu seçim onları həmişə "
"gizlədir."

#: ../build/bin/preferences_gen.h:3921
msgid "HDR alignment"
msgstr "HDR düzləndirilməsi"

#: ../build/bin/preferences_gen.h:3931
msgid "auto-align frames when merging HDR brackets"
msgstr ""
"ekspozisiya sıralarını HDR üçün birləşdirərkən çərçivələri avtomatik "
"düzləndir"

#: ../build/bin/preferences_gen.h:3939
msgid ""
"register and warp exposure brackets onto a reference frame before merging, "
"removing ghosting caused by a shaky tripod or handheld shots.\n"
"only effective when darktable is built with OpenCV."
msgstr ""
"birləşdirmədən əvvəl ekspozisiya sırasındakı çərçivələri istinad "
"çərçivəsinə uyğunlaşdırır və deformasiya edir, bununla qeyri-sabit ştativin "
"və ya əllə çəkilişin yaratdığı ikiləşməni aradan qaldırır.\n"
"yalnız darktable OpenCV ilə yığıldıqda təsirlidir."

#: ../build/bin/preferences_gen.h:3952
msgid "pick the HDR alignment reference automatically"
msgstr "HDR düzləndirilməsi üçün istinadı avtomatik seç"

#: ../build/bin/preferences_gen.h:3960
msgid ""
"before merging, examine every bracket and align to the one richest in detail "
"instead of the first frame.\n"
"improves alignment when the first exposure is a poor template, at the cost "
"of one extra decode pass over the frames.\n"
"requires auto-align and an OpenCV build."
msgstr ""
"birləşdirmədən əvvəl sıradakı hər çərçivəni yoxlayır və birinci çərçivə "
"əvəzinə ən çox detalı olan çərçivəyə görə düzləndirir.\n"
"birinci ekspozisiya zəif şablon olduqda çərçivələrin bir dəfə əlavə "
"dekodlaşdırılması hesabına düzləndirməni yaxşılaşdırır.\n"
"avtomatik düzləndirmə və OpenCV ilə yığılmış versiya tələb olunur."

#: ../build/bin/preferences_gen.h:3973
msgid "alignment detail (proxy scale)"
msgstr "düzləndirmə detallılığı (köməkçi təsvirin miqyası)"

#: ../build/bin/preferences_gen.h:3986 ../build/bin/preferences_gen.h:4014
#: ../build/bin/preferences_gen.h:4042
#, c-format
msgid "double click to reset to `%.03f'"
msgstr "iki dəfə kliklədikdə `%.03f' dəyərinə sıfırlayır"

#: ../build/bin/preferences_gen.h:3988
msgid ""
"fraction of the full sensor resolution at which feature detection and "
"alignment are computed.\n"
"higher values find more, more distinctive features (better on repetitive or "
"low-contrast scenes) but cost roughly (scale / 0.5)^2 more time and memory.\n"
"0.5 restores the legacy speed."
msgstr ""
"xarakterik nöqtələrin aşkarlanması və düzləndirmə üçün sensorun tam "
"ayırdetməsinin hansı hissəsindən istifadə olunduğunu müəyyən edir.\n"
"daha yüksək dəyərlər daha çox və daha fərqləndirici xarakterik nöqtələr "
"tapır (təkrarlanan və ya aşağı kontrastlı səhnələrdə daha yaxşıdır), amma "
"təxminən (miqyas / 0.5)^2 dəfə çox vaxt və yaddaş tələb edir.\n"
"0.5 köhnə sürəti bərpa edir."

#: ../build/bin/preferences_gen.h:4001
msgid "shadow lift for feature detection (gamma)"
msgstr "xarakterik nöqtələri aşkarlamaq üçün kölgələrin açılması (qamma)"

#: ../build/bin/preferences_gen.h:4016
msgid ""
"display-gamma applied to the linear raw before feature detection, to lift "
"shadow detail into the detector's range.\n"
"1.0 disables it. higher values help under-exposed frames but can amplify "
"shadow noise; the percentile stretch already does part of this, so the "
"effect is scene-dependent."
msgstr ""
"kölgə detallarını aşkarlayıcının diapazonuna gətirmək üçün xarakterik "
"nöqtələrin aşkarlanmasından əvvəl xətti RAW-a tətbiq edilən ekran qamması.\n"
"1.0 bunu söndürür. daha yüksək dəyərlər az ekspozisiyalı çərçivələrə kömək "
"edir, amma kölgələrdəki küyü gücləndirə bilər; persentil üzrə genişləndirmə "
"artıq bunun bir hissəsini yerinə yetirir, buna görə effekt səhnədən "
"asılıdır."

#: ../build/bin/preferences_gen.h:4029
msgid "local contrast for feature detection (CLAHE clip)"
msgstr ""
"xarakterik nöqtələri aşkarlamaq üçün yerli kontrast (CLAHE məhdudlaşdırması)"

#: ../build/bin/preferences_gen.h:4044
msgid ""
"clip limit of the local contrast enhancement (CLAHE) applied before feature "
"detection. 0 disables it.\n"
"enabling it (e.g. 2.0) helps detect features on extremely under-exposed "
"frames, but on repetitive textures (façades, railings, foliage) it can "
"change descriptor signatures between exposures and cause mis-alignment, so "
"it is off by default."
msgstr ""
"xarakterik nöqtələrin aşkarlanmasından əvvəl tətbiq edilən yerli kontrast "
"gücləndirməsinin (CLAHE) məhdudlaşdırma həddi. 0 bunu söndürür.\n"
"bunun aktivləşdirilməsi (məsələn, 2.0) çox az ekspozisiyalı çərçivələrdə "
"xarakterik nöqtələri aşkarlamağa kömək edir, amma təkrarlanan teksturalarda "
"(fasadlar, məhəccərlər, yarpaqlar) ekspozisiyalar arasında deskriptor "
"xüsusiyyətlərini dəyişərək yanlış düzləndirməyə səbəb ola bilər, buna görə "
"standart olaraq söndürülüb."

#: ../build/bin/preferences_gen.h:4057
msgid "feature budget per frame (keypoints)"
msgstr "hər çərçivə üçün xüsusiyyət limiti (əsas nöqtələr)"

#: ../build/bin/preferences_gen.h:4076
msgid ""
"maximum number of SIFT keypoints kept per frame after spatial balancing, "
"before matching.\n"
"balancing both frames to a common budget keeps a feature-dense frame from "
"flooding the matcher with ambiguous candidates."
msgstr ""
"uyğunlaşdırmadan əvvəl məkan üzrə balanslaşdırmadan sonra hər çərçivədə "
"saxlanılan SIFT əsas nöqtələrinin maksimum sayı.\n"
"hər iki çərçivəni ortaq limitə uyğun balanslaşdırmaq xüsusiyyətləri sıx "
"olan çərçivənin uyğunlaşdırıcını qeyri-müəyyən namizədlərlə doldurmasının "
"qarşısını alır."

#: ../build/bin/preferences_gen.h:4089
msgid "save alignment debug images"
msgstr ""
"şəkillərin üst-üstə uyğunlaşdırılmasını yoxlamaq üçün sazlama şəkillərini "
"yadda saxla"

#: ../build/bin/preferences_gen.h:4097
msgid ""
"write per-frame diagnostic images while merging: the feature-detection "
"input, the detected keypoints and all feature matches (green = inlier, red = "
"outlier).\n"
"saved as Netpbm (.pgm/.ppm) in a darktable_hdr_align_debug folder in the "
"system temp directory (or the folder named by the DT_HDR_DEBUG_IMAGE_DIR "
"environment variable). for diagnosing alignment problems; off by default."
msgstr ""
"birləşdirmə zamanı hər çərçivə üçün diaqnostik şəkillər yazır: "
"xüsusiyyətlərin aşkarlanması üçün giriş şəkli, aşkarlanmış əsas nöqtələr və "
"bütün xüsusiyyət uyğunluqları (yaşıl = uyğun, qırmızı = kənar).\n"
"sistemin müvəqqəti qovluğundakı darktable_hdr_align_debug qovluğunda (və ya "
"DT_HDR_DEBUG_IMAGE_DIR mühit dəyişənində adı verilən qovluqda) Netpbm "
"(.pgm/.ppm) formatında yadda saxlanılır. şəkillərin üst-üstə "
"uyğunlaşdırılması ilə bağlı problemlərin diaqnostikası üçündür; standart "
"olaraq söndürülüb."

#: ../build/bin/preferences_gen.h:4107
msgid "CPU / memory"
msgstr "CPU / yaddaş"

#: ../build/bin/preferences_gen.h:4117
msgid "darktable resources"
msgstr "darktable resursları"

#: ../build/bin/preferences_gen.h:4127
#, no-c-format
msgid ""
"defines how much darktable may take from your system resources:\n"
" - 'default': darktable takes ~50% of your systems resources, which is "
"enough to be performant.\n"
" - 'small': should be used if you are simultaneously running applications "
"taking large parts of your systems memory or OpenCL/GL applications like "
"games or Hugin.\n"
" - 'large': is the best option if you are not running other applications at "
"the same time as darktable and want it to take most of your systems "
"resources for performance."
msgstr ""
"darktable proqramının sistem resurslarınızdan nə qədər istifadə edə "
"biləcəyini müəyyən edir:\n - 'standart': darktable sistem resurslarınızın "
"~50%-dən istifadə edir, bu da yaxşı məhsuldarlıq üçün kifayətdir.\n"
" - 'kiçik': eyni vaxtda sistem yaddaşınızın böyük hissəsindən istifadə edən "
"tətbiqlər və ya oyunlar, yaxud Hugin kimi OpenCL/GL tətbiqləri "
"işlədirsinizsə, istifadə edilməlidir.\n"
" - 'böyük': darktable ilə eyni vaxtda digər tətbiqləri işlətmirsinizsə və "
"məhsuldarlıq üçün sistem resurslarınızın çox hissəsindən istifadə etməsini "
"istəyirsinizsə, ən yaxşı seçimdir."

#: ../build/bin/preferences_gen.h:4133
msgid "OpenCL GPU acceleration"
msgstr "OpenCL GPU sürətləndirilməsi"

#: ../build/bin/preferences_gen.h:4143
msgid "activate OpenCL support"
msgstr "OpenCL dəstəyini aktivləşdir"

#: ../build/bin/preferences_gen.h:4151
msgid ""
"if found, use OpenCL runtime on your system to speed up processing by using "
"your graphics card(s).\n"
"can be switched on and off at any time."
msgstr ""
"sistemdə OpenCL icra mühiti aşkarlandıqda, qrafik kartlarından istifadə "
"edərək emalı sürətləndirir.\nistənilən vaxt aktivləşdirilə və söndürülə "
"bilər."

#: ../build/bin/preferences_gen.h:4164
msgid "OpenCL fast mode"
msgstr "OpenCL sürətli rejimi"

#: ../build/bin/preferences_gen.h:4172
msgid ""
"if set the OpenCL compiler uses aggressive optimizing for better performance "
"with reduced precision so more differences between CPU and OpenCL are "
"expected."
msgstr ""
"seçildikdə, OpenCL kompilyatoru daha yaxşı məhsuldarlıq üçün dəqiqliyi "
"azaldan güclü optimallaşdırmadan istifadə edir, buna görə CPU və OpenCL "
"arasında daha çox fərq gözlənilir."

#: ../build/bin/preferences_gen.h:4185
msgid "OpenCL scheduling profile"
msgstr "OpenCL planlaşdırma profili"

#: ../build/bin/preferences_gen.h:4194
msgid ""
"defines how preview and full pixelpipe tasks are scheduled on OpenCL enabled "
"systems:\n"
" - 'default': GPU processes full and CPU processes preview pipe (adaptable "
"by config parameters),\n"
" - 'multiple GPUs': process both pixelpipes in parallel on two different "
"GPUs,\n"
" - 'very fast GPU': process both pixelpipes sequentially on the GPU."
msgstr ""
"OpenCL aktivləşdirilmiş sistemlərdə önbaxış və tam piksel emalı zənciri "
"tapşırıqlarının necə planlaşdırıldığını müəyyən edir:\n"
" - 'standart': GPU tam zənciri, CPU isə önbaxış zəncirini emal edir "
"(konfiqurasiya parametrləri ilə uyğunlaşdırıla bilər),\n"
" - 'çoxsaylı GPU-lar': hər iki piksel emalı zəncirini iki fərqli GPU-da "
"paralel emal edir,\n - 'çox sürətli GPU': hər iki piksel emalı zəncirini "
"GPU-da ardıcıl emal edir."

#: ../build/bin/preferences_gen.h:4207
msgid "tuned GPU memory"
msgstr "tənzimlənmiş GPU yaddaşı"

#: ../build/bin/preferences_gen.h:4215
msgid ""
"if enabled on a system with multiple OpenCL devices you may specify a safety "
"margin per device (headroom, default is 600MB)"
msgstr ""
"çoxsaylı OpenCL cihazları olan sistemdə aktivləşdirildikdə, hər cihaz üçün "
"təhlükəsizlik ehtiyatı təyin edə bilərsiniz (ehtiyat yaddaş, standart dəyər "
"600MB-dır)"

#: ../build/bin/preferences_gen.h:4225
msgid "OpenCL drivers"
msgstr "OpenCL drayverləri"

#: ../build/bin/preferences_gen.h:4235
msgid "Intel GPU"
msgstr "Intel GPU"

#: ../build/bin/preferences_gen.h:4243
msgid "Intel(R) OpenCL Graphics for all supported platforms (vendor provided)"
msgstr ""
"Bütün dəstəklənən platformalar üçün Intel(R) OpenCL Graphics (istehsalçı "
"tərəfindən təmin edilir)"

#: ../build/bin/preferences_gen.h:4256
msgid "Nvidia CUDA"
msgstr "Nvidia CUDA"

#: ../build/bin/preferences_gen.h:4264
msgid "Nvidia CUDA based OpenCL (vendor provided)"
msgstr "Nvidia CUDA əsasında OpenCL (istehsalçı tərəfindən təmin edilir)"

#: ../build/bin/preferences_gen.h:4277
msgid "AMD ROCm"
msgstr "AMD ROCm"

#: ../build/bin/preferences_gen.h:4285
msgid "AMD Accelerated Parallel Processing (vendor provided)"
msgstr ""
"AMD Accelerated Parallel Processing (istehsalçı tərəfindən təmin edilir)"

#: ../build/bin/preferences_gen.h:4298
msgid "RustiCL"
msgstr "RustiCL"

#: ../build/bin/preferences_gen.h:4306
msgid ""
"RustiCL Mesa OpenCL. if you want to use this, you should disable the vendor "
"driver"
msgstr ""
"RustiCL Mesa OpenCL. bundan istifadə etmək istəyirsinizsə, istehsalçının "
"drayverini söndürməlisiniz"

#: ../build/bin/preferences_gen.h:4319
msgid "Apple"
msgstr "Apple"

#: ../build/bin/preferences_gen.h:4327
msgid "Apple OpenCL (vendor provided)"
msgstr "Apple OpenCL (istehsalçı tərəfindən təmin edilir)"

#: ../build/bin/preferences_gen.h:4340
msgid "Microsoft OpenCLOn12"
msgstr "Microsoft OpenCLOn12"

#: ../build/bin/preferences_gen.h:4348
msgid ""
"Microsoft OpenCLOn12, only use this if the vendor provided driver does not "
"work or there is none provided."
msgstr ""
"Microsoft OpenCLOn12, bundan yalnız istehsalçının təmin etdiyi drayver "
"işləmirsə və ya drayver təmin edilməyibsə istifadə edin."

#: ../build/bin/preferences_gen.h:4361
msgid "other platforms"
msgstr "digər platformalar"

#: ../build/bin/preferences_gen.h:4369
msgid ""
"if set, all unspecified platforms are accepted. only do this if no vendor "
"driver is available"
msgstr ""
"seçildikdə, göstərilməmiş bütün platformalar qəbul edilir. bunu yalnız "
"istehsalçının drayveri mövcud olmadıqda edin"

#: ../build/bin/preferences_gen.h:4379
msgid "security"
msgstr "təhlükəsizlik"

#: ../build/bin/preferences_gen.h:4394
msgid "ask before removing images from the library"
msgstr "şəkilləri kitabxanadan çıxarmazdan əvvəlcə soruş"

#: ../build/bin/preferences_gen.h:4402
msgid "always ask the user before removing image information from the library"
msgstr ""
"şəkil məlumatlarını kitabxanadan çıxarmazdan əvvəl həmişə istifadəçidən "
"təsdiq istəyir"

#: ../build/bin/preferences_gen.h:4411
msgid "ask before deleting images from disk"
msgstr "şəkilləri diskdən silməzdən əvvəlcə soruş"

#: ../build/bin/preferences_gen.h:4419
msgid "always ask the user before any image file is deleted"
msgstr ""
"hər hansı şəkil faylını silməzdən əvvəl həmişə istifadəçidən təsdiq istəyir"

#: ../build/bin/preferences_gen.h:4428
msgid "ask before discarding history stack"
msgstr "tarixçə yığınını ləğv etməzdən əvvəlcə soruş"

#: ../build/bin/preferences_gen.h:4436
msgid "always ask the user before history stack is discarded on any image"
msgstr ""
"hər hansı şəklin tarixçə yığınını ləğv etməzdən əvvəl həmişə istifadəçidən "
"təsdiq istəyir"

#: ../build/bin/preferences_gen.h:4445
msgid "try to use trash when deleting images"
msgstr "şəkilləri silərkən zibil qutusundan istifadə etməyə çalış"

#: ../build/bin/preferences_gen.h:4453
msgid ""
"send files to trash instead of permanently deleting files on system that "
"supports it"
msgstr ""
"bu funksiyanı dəstəkləyən sistemlərdə faylları həmişəlik silmək əvəzinə "
"zibil qutusuna göndərir"

#: ../build/bin/preferences_gen.h:4462
msgid "ask before moving images from film roll folder"
msgstr ""
"şəkillərin yerini fotoplyonka rulosunun qovluğundan başqa yerə dəyişməzdən "
"əvvəl soruş"

#: ../build/bin/preferences_gen.h:4470
msgid "always ask the user before any image file is moved."
msgstr ""
"hər hansı şəkil faylının yerini dəyişməzdən əvvəl həmişə istifadəçidən "
"təsdiq istəyir."

#: ../build/bin/preferences_gen.h:4479
msgid "ask before copying images to new film roll folder"
msgstr ""
"şəkilləri yeni fotoplyonka rulosu qovluğuna kopyalamazdan əvvəlcə soruş"

#: ../build/bin/preferences_gen.h:4487
msgid "always ask the user before any image file is copied."
msgstr ""
"hər hansı şəkil faylını kopyalamazdan əvvəl həmişə istifadəçidən təsdiq "
"istəyir."

#: ../build/bin/preferences_gen.h:4496
msgid "ask before removing empty folders"
msgstr "boş qovluqları çıxarmazdan əvvəlcə soruş"

#: ../build/bin/preferences_gen.h:4504
msgid ""
"always ask the user before removing any empty folder. this can happen after "
"moving or deleting images."
msgstr ""
"hər hansı boş qovluğu çıxarmazdan əvvəl həmişə istifadəçidən təsdiq "
"istəyir. bu, şəkillərin yerini dəyişdikdən və ya onları sildikdən sonra baş "
"verə bilər."

#: ../build/bin/preferences_gen.h:4513
msgid "ask before deleting a tag"
msgstr "etiketi silməzdən əvvəlcə soruş"

#: ../build/bin/preferences_gen.h:4529
msgid "ask before deleting a style"
msgstr "üslubu silməzdən əvvəlcə soruş"

#: ../build/bin/preferences_gen.h:4545
msgid "ask before deleting a preset"
msgstr "hazır parametr dəstini silməzdən əvvəlcə soruş"

#: ../build/bin/preferences_gen.h:4553
msgid "will ask for confirmation before deleting or overwriting a preset"
msgstr ""
"hazır parametr dəstini silməzdən və ya üzərinə yazmazdan əvvəl təsdiq "
"istəyir"

#: ../build/bin/preferences_gen.h:4562
msgid "ask before exporting in overwrite mode"
msgstr "üzərinə yazma rejimində ixrac etməzdən əvvəlcə soruş"

#: ../build/bin/preferences_gen.h:4570
msgid "will ask for confirmation before exporting files in overwrite mode"
msgstr "faylları üzərinə yazma rejimində ixrac etməzdən əvvəl təsdiq istəyir"

#: ../build/bin/preferences_gen.h:4576 ../src/libs/tools/viewswitcher.c:158
msgid "other"
msgstr "digər"

#: ../build/bin/preferences_gen.h:4586
msgid "password storage backend to use"
msgstr "şifrə saxlamaq üçün istifadə ediləcək altsistem"

#: ../build/bin/preferences_gen.h:4603
msgid ""
"the storage backend for password storage: auto, none, libsecret, kwallet, "
"apple_keychain, windows_credentials"
msgstr ""
"şifrələrin saxlanması üçün saxlama altsistemi: avtomatik, heç biri, "
"libsecret, kwallet, apple_keychain, windows_credentials"

#: ../build/bin/preferences_gen.h:4612
msgid "auto login to storage server"
msgstr "saxlama serverinə avtomatik giriş"

#: ../build/bin/preferences_gen.h:4620
msgid ""
"automatically login to the configured storage server. this requires that a "
"password storage backend is set."
msgstr ""
"təyin edilmiş saxlama serverinə avtomatik olaraq daxil olur. bunun üçün "
"şifrələri saxlama altsistemi təyin edilməlidir."

#: ../build/bin/preferences_gen.h:4629
msgid "executable for playing audio files"
msgstr "səs fayllarını səsləndirmək üçün icra faylı"

#: ../build/bin/preferences_gen.h:4642
msgid ""
"this external program is used to play audio files some cameras record to "
"keep notes for images"
msgstr ""
"bu xarici proqram bəzi kameraların şəkillər üçün qeydlər saxlamaq məqsədilə "
"yazdığı səs fayllarını səsləndirmək üçün istifadə olunur"

#: ../build/bin/preferences_gen.h:4652
msgid "storage"
msgstr "saxlama"

#: ../build/bin/preferences_gen.h:4657 ../src/control/crawler.c:1537
msgid "database"
msgstr "verilənlər bazası"

#: ../build/bin/preferences_gen.h:4667
msgid "allow for multiple workspaces"
msgstr "çoxsaylı iş sahələrinə icazə ver"

#: ../build/bin/preferences_gen.h:4675
msgid "allow multiple workspaces which can be selected at startup"
msgstr ""
"başlanğıcda seçilə bilən çoxsaylı iş sahələrindən istifadəyə icazə verir"

#: ../build/bin/preferences_gen.h:4684
msgid "create database snapshot"
msgstr "verilənlər bazasının anlıq nüsxəsünü yarat"

#: ../build/bin/preferences_gen.h:4693
msgid ""
"database snapshots are created right before closing darktable. options allow "
"you to choose how often to make snapshots:\n"
" - 'never': simply don't do snapshots. that way the only snapshots done are "
"mandatory version-upgrade snapshots\n"
" - 'once a month': create snapshot if a month has passed since last "
"snapshot\n"
" - 'once a week': create snapshot if 7 days had passed since last snapshot\n"
" - 'once a day': create snapshot if over 24h passed since last snapshot\n"
" - 'on close': create snapshot every time darktable is closed"
msgstr ""
"verilənlər bazasının anlıq nüsxələri darktable bağlanmazdan dərhal əvvəl "
"yaradılır. seçimlər anlıq nüsxələrin hansı tezliklə yaradılacağını müəyyən "
"etməyə imkan verir:\n - 'heç vaxt': anlıq nüsxələr yaratmır. bu halda "
"yalnız versiya yüksəldilməsi üçün məcburi anlıq nüsxələr yaradılır\n"
" - 'ayda bir dəfə': son anlıq nüsxədən bir ay keçibsə, anlıq nüsxə yaradır\n"
" - 'həftədə bir dəfə': son anlıq nüsxədən 7 gün keçibsə, anlıq nüsxə "
"yaradır\n - 'gündə bir dəfə': son anlıq nüsxədən 24 saatdan çox keçibsə, "
"anlıq nüsxə yaradır\n - 'bağlanarkən': darktable hər dəfə bağlananda anlıq "
"nüsxə yaradır"

#: ../build/bin/preferences_gen.h:4702
msgid "how many snapshots to keep"
msgstr "saxlanılacaq anlıq nüsxələrin sayı"

#: ../build/bin/preferences_gen.h:4720
msgid ""
"after successfully creating snapshot, how many older snapshots to keep "
"(excluding mandatory version update ones). enter -1 to keep all snapshots\n"
"keep in mind that snapshots do take some space and you only need the most "
"recent one for successful restore"
msgstr ""
"anlıq nüsxə uğurla yaradıldıqdan sonra saxlanılacaq köhnə anlıq nüsxələrin "
"sayını müəyyən edir (versiya yeniləməsi üçün məcburi olanlar istisna "
"olmaqla). -1 dəyəri bütün anlıq nüsxələri saxlayır\n"
"anlıq nüsxələr müəyyən yer tutur və uğurlu bərpa üçün yalnız ən sonuncu "
"nüsxə tələb olunur"

#: ../build/bin/preferences_gen.h:4726 ../src/libs/copy_history.c:148
msgid "XMP sidecar files"
msgstr "XMP müşayiətçi faylları"

#: ../build/bin/preferences_gen.h:4736
msgid "create XMP files"
msgstr "XMP faylları yarat"

#: ../build/bin/preferences_gen.h:4745
msgid ""
"XMP sidecar files store all editing steps, ratings, tags and color labels "
"alongside your images in an open format readable by other applications, and "
"provide an emergency backup if the database and its backups are lost\n"
"\n"
"<b>never:</b> information is stored only in darktable's database; if it is "
"lost or corrupted, your edits cannot be recovered from the files\n"
"\n"
"<b>after edit:</b> the XMP file is created after the first intentional "
"(i.e., non auto-applied) edit and updated after each editing session\n"
"\n"
"<b>on import:</b> an XMP file is created when the image is imported, and "
"updated after each change"
msgstr ""
"XMP müşayiətçi faylları bütün redaktə addımlarını, reytinqləri, etiketləri "
"və rəng nişanlarını şəkillərinizlə yanaşı digər tətbiqlərin oxuya bildiyi "
"açıq formatda saxlayır və verilənlər bazası ilə onun ehtiyat nüsxələri "
"itdikdə fövqəladə ehtiyat nüsxə təmin edir\n"
"\n<b>heç vaxt:</b> məlumatlar yalnız darktable proqramının verilənlər "
"bazasında saxlanılır; o itərsə və ya zədələnərsə, redaktələrinizi "
"fayllardan bərpa etmək mümkün deyil\n\n"
"<b>redaktədən sonra:</b> XMP faylı ilk məqsədli (yəni avtomatik tətbiq "
"edilməmiş) redaktədən sonra yaradılır və hər redaktə seansından sonra "
"yenilənir\n\n<b>idxal zamanı:</b> XMP faylı şəkil idxal ediləndə yaradılır "
"və hər dəyişiklikdən sonra yenilənir"

#: ../build/bin/preferences_gen.h:4754
msgid "store XMP tags in compressed format"
msgstr "XMP etiketlərini sıxılmış formatda saxla"

#: ../build/bin/preferences_gen.h:4763
msgid ""
"entries in XMP tags can get rather large and may exceed the available space "
"to store the history stack in output files.\n"
"this option allows XMP tags to be compressed and save space."
msgstr ""
"XMP etiketlərindəki yazılar olduqca böyük ola bilər və çıxış fayllarında "
"tarixçə yığınını saxlamaq üçün mövcud yeri aşa bilər.\n"
"bu seçim XMP etiketlərini sıxmağa və yerə qənaət etməyə imkan verir."

#: ../build/bin/preferences_gen.h:4772
msgid "auto-save interval"
msgstr "avtomatik yadda saxlama intervalı"

#: ../build/bin/preferences_gen.h:4790
msgid ""
"automatically save history while developing using the given interval (in "
"seconds); set to zero to disable auto-saving. auto-saving might be disabled "
"on slow drives."
msgstr ""
"emal zamanı verilmiş intervalla (saniyə ilə) tarixçəni avtomatik olaraq "
"yadda saxlayır; sıfır dəyəri avtomatik yadda saxlamanı söndürür. yavaş "
"disklərdə avtomatik yadda saxlama söndürülə bilər."

#: ../build/bin/preferences_gen.h:4799
msgid "look for updated XMP files on startup"
msgstr "başlanğıcda yenilənmiş XMP fayllarını axtar"

#: ../build/bin/preferences_gen.h:4807
msgid ""
"check file modification times of all XMP files on startup to check if any "
"got updated in the meantime"
msgstr ""
"bu müddətdə hər hansı XMP faylının yenilənib-yenilənmədiyini müəyyən etmək "
"üçün başlanğıcda bütün XMP fayllarının dəyişdirilmə vaxtlarını yoxlayır"

#: ../build/bin/preferences_gen.h:4817
msgid "miscellaneous"
msgstr "müxtəlif"

#: ../build/bin/preferences_gen.h:4822
msgid "interface"
msgstr "interfeys"

#: ../build/bin/preferences_gen.h:4832
msgid "show splash screen at startup"
msgstr "başlanğıcda açılış ekranını göstər"

#: ../build/bin/preferences_gen.h:4840
msgid ""
"display a small window showing the progress of darktable startup before the "
"main window appears"
msgstr ""
"əsas pəncərə görünməzdən əvvəl darktable proqramının başladılmasının "
"gedişatını göstərən kiçik pəncərə açır"

#: ../build/bin/preferences_gen.h:4849
msgid "show welcome screen on next run"
msgstr "növbəti işəsalmada qarşılama ekranını göstər"

#: ../build/bin/preferences_gen.h:4857
msgid "display the welcome setup screen the next time darktable is launched"
msgstr ""
"darktable növbəti dəfə başladıldıqda ilkin quraşdırma üçün qarşılama "
"ekranını göstərir"

#: ../build/bin/preferences_gen.h:4866
msgid "load default shortcuts at startup"
msgstr "başlanğıcda standart qısayolları yüklə"

#: ../build/bin/preferences_gen.h:4874
msgid ""
"load default shortcuts before user settings. switch off to prevent deleted "
"defaults returning"
msgstr ""
"istifadəçi parametrlərindən əvvəl standart qısayolları yükləyir. "
"söndürüldükdə, silinmiş standart qısayolların bərpasının qarşısını alır"

#: ../build/bin/preferences_gen.h:4883
msgid "scale slider step with min/max"
msgstr "sürgünün addımını minimum/maksimum ilə miqyasla"

#: ../build/bin/preferences_gen.h:4891
msgid "vary slider step size with min/max range"
msgstr ""
"sürgünün addım ölçüsünü minimum və maksimum dəyərlər arasındakı diapazona "
"uyğun dəyişir"

#: ../build/bin/preferences_gen.h:4900
msgid "marker shape"
msgstr "işarələyicinin forması"

#: ../build/bin/preferences_gen.h:4909
msgid "the shape of the slider marker"
msgstr "sürgü işarələyicisinin forması"

#: ../build/bin/preferences_gen.h:4918
msgid "automatically update module name"
msgstr "modul adını avtomatik olaraq yenilə"

#: ../build/bin/preferences_gen.h:4926
msgid ""
"if enabled, the module name will be automatically updated to match a preset "
"name or a preset instance name if present."
msgstr ""
"aktivləşdirildikdə, modul adı hazır parametr dəstinin adına və ya varsa, "
"hazır parametr dəstinin nüsxə adına uyğun olaraq avtomatik yenilənəcək."

#: ../build/bin/preferences_gen.h:4935
msgid "sort built-in presets first"
msgstr "daxili hazır parametr dəstlərini əvvəl sırala"

#: ../build/bin/preferences_gen.h:4943
msgid ""
"whether to show built-in presets first before user's presets in presets menu."
msgstr ""
"hazır parametr dəstləri menyusunda daxili hazır parametr dəstlərinin "
"istifadəçinin hazır parametr dəstlərindən əvvəl "
"göstərilib-göstərilməyəcəyini müəyyən edir."

#: ../build/bin/preferences_gen.h:4952
msgid "mouse wheel scrolls modules side panel by default"
msgstr "sıçan çarxı standart olaraq modulların yan panelini sürüşdürür"

#: ../build/bin/preferences_gen.h:4960
msgid ""
"in darktable's darkroom, where you do your edits, all controls are listed on "
"a panel on the right; you can choose whether you want to use the scroll "
"wheel or scroll gesture on your touchpad to scroll the panel, or to change "
"the values of the control under the pointer; this latter modality enables "
"faster editing, but this can be dangerous because you can change the values ​​"
"of the module controls without noticing if you are not used to it\n"
"\n"
"<b>enabled:</b> the mouse wheel scrolls the modules panel and with "
"<i>Ctrl+Alt</i> adjusts a control's value\n"
"\n"
"<b>disabled:</b> the mouse wheel adjusts the control under the pointer and "
"with <i>Ctrl+Alt</i> scrolls the panel."
msgstr ""
"redaktələrinizi etdiyiniz darktable qaranlıq otağında bütün idarəetmə "
"elementləri sağdakı paneldə yerləşir; paneli sürüşdürmək, yaxud "
"göstəricinin altındakı idarəetmə elementinin dəyərlərini dəyişmək üçün "
"sıçan çarxından və ya toxunma panelində sürüşdürmə jestindən istifadə "
"etməyi seçə bilərsiniz; sonuncu üsul daha sürətli redaktəyə imkan verir, "
"amma buna öyrəşməmisinizsə, modulun idarəetmə elementlərinin dəyərlərini "
"fərqinə varmadan dəyişə biləcəyiniz üçün təhlükəli ola bilər\n"
"\n<b>aktivləşdirilmiş:</b> sıçan çarxı modullar panelini sürüşdürür və "
"<i>Ctrl+Alt</i> ilə idarəetmə elementinin dəyərini tənzimləyir\n"
"\n<b>söndürülmüş:</b> sıçan çarxı göstəricinin altındakı idarəetmə "
"elementini tənzimləyir və <i>Ctrl+Alt</i> ilə paneli sürüşdürür."

#: ../build/bin/preferences_gen.h:4969
msgid "enable touchpad gestures in darkroom"
msgstr "qaranlıq otaqda toxunma paneli jestlərini aktivləşdir"

#: ../build/bin/preferences_gen.h:4977
msgid ""
"use two-finger touchpad gestures in darkroom for panning and pinch-to-zoom. "
"<b>enabled:</b> touchpad pinch gestures zoom the image and two-finger "
"touchpad scrolling pans it; <i>Ctrl+scroll</i> still uses the legacy zoom "
"behavior. <b>disabled:</b> touchpad gestures are ignored and darkroom falls "
"back to the legacy scroll behavior, including <i>Ctrl+scroll</i> for zooming "
"in and out."
msgstr ""
"qaranlıq otaqda yerdəyişmə və barmaqları birləşdirib-ayırmaqla "
"yaxınlaşdırma üçün toxunma panelinin iki barmaq jestlərindən istifadə edir. "
"<b>aktivləşdirilmiş:</b> toxunma panelində barmaqları birləşdirib-ayırma "
"jestləri şəkli yaxınlaşdırır, iki barmaqla sürüşdürmə isə onun yerini "
"dəyişir; <i>Ctrl ilə sürüşdür</i> əvvəlki yaxınlaşdırma davranışından "
"istifadə etməyə davam edir. <b>söndürülmüş:</b> toxunma paneli jestləri "
"nəzərə alınmır və qaranlıq otaq əvvəlki sürüşdürmə davranışına, o cümlədən "
"yaxınlaşdırıb-uzaqlaşdırmaq üçün <i>Ctrl ilə sürüşdür</i> istifadəsinə "
"qayıdır."

#: ../build/bin/preferences_gen.h:4986
msgid "constrain darkroom zoom between screen fit and 100%"
msgstr ""
"qaranlıq otaqda yaxınlaşdırmanı ekrana sığdırma ilə 100% arasında "
"məhdudlaşdır"

#: ../build/bin/preferences_gen.h:4995
#, no-c-format
msgid ""
"limits scroll-wheel and pinch-to-zoom in the darkroom to the range between "
"screen fit (zoom out) and 100% (zoom in). <b>enabled:</b> zoom is "
"constrained; hold <i>Ctrl</i> while zooming to temporarily lift the limit "
"and zoom beyond 100%. <b>disabled:</b> zoom is never constrained and the "
"additional <i>Ctrl</i> key press is not needed to zoom beyond 100%."
msgstr ""
"qaranlıq otaqda sıçan çarxı və barmaqları birləşdirib-ayırmaqla "
"yaxınlaşdırmanı ekrana sığdırma (uzaqlaşdırma) ilə 100% (yaxınlaşdırma) "
"arasındakı diapazonla məhdudlaşdırır. <b>aktivləşdirilmiş:</b> "
"yaxınlaşdırma məhdudlaşdırılır; məhdudiyyəti müvəqqəti götürmək və 100%-dən "
"artıq yaxınlaşdırmaq üçün yaxınlaşdırma zamanı <i>Ctrl</i> düyməsini basılı "
"saxla. <b>söndürülmüş:</b> yaxınlaşdırma heç vaxt məhdudlaşdırılmır və "
"100%-dən artıq yaxınlaşdırmaq üçün əlavə <i>Ctrl</i> düyməsini basmaq lazım "
"deyil."

#: ../build/bin/preferences_gen.h:5004
msgid "always show panels' scrollbars"
msgstr "panellərin sürüşdürmə zolaqlarını həmişə göstər"

#: ../build/bin/preferences_gen.h:5012
msgid ""
"defines whether the panel scrollbars should be always visible or activated "
"only depending on the content. (restart required)"
msgstr ""
"panelin sürüşdürmə zolaqlarının həmişə görünməli, yoxsa yalnız məzmundan "
"asılı olaraq aktivləşdirilməli olduğunu müəyyən edir. (yenidən başlatmaq "
"tələb olunur)"

#: ../build/bin/preferences_gen.h:5021
msgid "duration of the UI transitions in ms"
msgstr "interfeys keçidlərinin ms ilə müddəti"

#: ../build/bin/preferences_gen.h:5040
msgid ""
"how long the transitions take (in ms) for expanding or collapsing modules "
"and other UI elements"
msgstr ""
"modulları və digər interfeys elementlərini genişləndirmək və ya yığmaq üçün "
"keçidlərin müddəti (ms ilə)"

#: ../build/bin/preferences_gen.h:5049
msgid "auto-scroll filmstrip to center on selected image"
msgstr ""
"seçilmiş şəkli mərkəzə gətirmək üçün fotoplyonka lentini avtomatik sürüşdür"

#: ../build/bin/preferences_gen.h:5057
msgid ""
"when enabled, the filmstrip in culling mode and in the darkroom "
"automatically scrolls to center on the selected image"
msgstr ""
"aktivləşdirildikdə, çeşidləmə rejimində və qaranlıq otaqda fotoplyonka "
"lenti seçilmiş şəkli mərkəzə gətirmək üçün avtomatik olaraq sürüşür"

#: ../build/bin/preferences_gen.h:5066
msgid "position of the scopes module"
msgstr "ölçmə qrafikləri modulunun mövqeyi"

#: ../build/bin/preferences_gen.h:5075
msgid "position the scopes at the top-left or top-right of the screen"
msgstr ""
"ölçmə qrafiklərini ekranın yuxarı sol və ya yuxarı sağ hissəsində "
"yerləşdirir"

#: ../build/bin/preferences_gen.h:5084
msgid "method to use for getting the display profile"
msgstr "ekran profilini əldə etmək üçün istifadə ediləcək üsul"

#: ../build/bin/preferences_gen.h:5093
msgid ""
"this option allows to force a specific means of getting the current display "
"profile.\n"
"this is useful when one alternative gives wrong results"
msgstr ""
"bu seçim cari ekran profilini əldə etmək üçün müəyyən bir üsuldan məcburi "
"istifadə etməyə imkan verir.\nüsullardan biri yanlış nəticə verdikdə bu "
"faydalıdır"

#: ../build/bin/preferences_gen.h:5102
msgid "order or exclude MIDI devices"
msgstr "MIDI cihazlarını sırala və ya istisna et"

#: ../build/bin/preferences_gen.h:5115
msgid ""
"comma-separated list of device name fragments that if matched load MIDI "
"device at id given by location in list\n"
"add encoding and number of knobs like 'Loupedeck:127,BeatStep:63:16'\n"
"prefix with '-' to ignore matching devices\n"
"just '-' stops loading all further devices or on its own disables MIDI "
"completely"
msgstr ""
"vergüllə ayrılmış cihaz adı hissələrinin siyahısıdır; adı uyğun gələn MIDI "
"cihazı həmin hissənin siyahıdakı mövqeyinə uyğun identifikatorla yüklənir\n"
"'Loupedeck:127,BeatStep:63:16' nümunəsindəki kimi kodlaşdırma və fırlanan "
"düymələrin sayı da göstərilə bilər\nəvvəlinə '-' əlavə edildikdə uyğun "
"gələn cihazlar nəzərə alınmır\nyalnız '-' bütün sonrakı cihazların "
"yüklənməsini dayandırır və ya təkbaşına MIDI-ni tamamilə söndürür"

#. tags
#: ../build/bin/preferences_gen.h:5125 ../src/develop/lightroom.c:1573
#: ../src/gui/import_metadata.c:514 ../src/libs/export_metadata.c:197
#: ../src/libs/image.c:624 ../src/libs/metadata_view.c:175
msgid "tags"
msgstr "etiketlər"

#: ../build/bin/preferences_gen.h:5135
msgid "omit hierarchy in simple tag lists"
msgstr "sadə etiket siyahılarında iyerarxiyanı burax"

#: ../build/bin/preferences_gen.h:5143
msgid ""
"when creating an XMP sidecar file the hierarchical tags are also added as a "
"simple list\n"
"of non-hierarchical ones to make them visible to some other programs.\n"
"when this option is checked darktable will only include their last part\n"
"and ignore the rest. so 'foo|bar|baz' will only add 'baz'."
msgstr ""
"XMP müşayiətçi faylı yaradılarkən iyerarxik etiketlər bəzi digər "
"proqramlarda görünməsi üçün\niyerarxiyasız etiketlərdən ibarət sadə siyahı "
"şəklində də əlavə edilir.\nbu seçim işarələndikdə darktable yalnız onların "
"son hissəsini daxil edir\nvə qalanını nəzərə almır. beləliklə, "
"'nümunə|bölmə|altbölmə' üçün yalnız 'altbölmə' əlavə edilir."

#: ../build/bin/preferences_gen.h:5149
msgid "shortcuts with multiple instances"
msgstr "çoxsaylı nüsxələrlə qısayollar"

#: ../build/bin/preferences_gen.h:5159
msgid "prefer focused instance"
msgstr "fokuslanmış nüsxəyə üstünlük ver"

#: ../build/bin/preferences_gen.h:5167
msgid ""
"where multiple instances of a module are present, apply shortcuts to the "
"instance that has focus\n"
"if none are focused, the preferences below control rules that are followed "
"(in order) to decide which module instance shortcuts will be applied to.\n"
"note: blending shortcuts always apply to the focused instance"
msgstr ""
"modulun çoxsaylı nüsxələri olduqda, qısayolları fokuslanmış nüsxəyə tətbiq "
"edir\nheç biri fokuslanmayıbsa, aşağıdakı parametrlər qısayolların hansı "
"modul nüsxəsinə tətbiq ediləcəyini müəyyən edən qaydaları ardıcıllıqla "
"tənzimləyir.\nqeyd: qarışdırma qısayolları həmişə fokuslanmış nüsxəyə "
"tətbiq edilir"

#: ../build/bin/preferences_gen.h:5176
msgid "prefer expanded instances"
msgstr "genişləndirilmiş nüsxələrə üstünlük ver"

#: ../build/bin/preferences_gen.h:5184
msgid "if instances of the module are expanded, ignore collapsed instances"
msgstr ""
"modulun genişləndirilmiş nüsxələri varsa, yığılmış nüsxələri nəzərə almır"

#: ../build/bin/preferences_gen.h:5193
msgid "prefer enabled instances"
msgstr "aktivləşdirilmiş nüsxələrə üstünlük ver"

#: ../build/bin/preferences_gen.h:5201
msgid ""
"after applying the above rule, if instances of the module are active, ignore "
"inactive instances"
msgstr ""
"yuxarıdakı qayda tətbiq edildikdən sonra modulun aktiv nüsxələri varsa, "
"qeyri-aktiv nüsxələri nəzərə almır"

#: ../build/bin/preferences_gen.h:5210
msgid "prefer unmasked instances"
msgstr "maskasız nüsxələrə üstünlük ver"

#: ../build/bin/preferences_gen.h:5218
msgid ""
"after applying the above rules, if instances of the module are unmasked, "
"ignore masked instances"
msgstr ""
"yuxarıdakı qaydalar tətbiq edildikdən sonra modulun maskasız nüsxələri "
"varsa, maskalı nüsxələri nəzərə almır"

#: ../build/bin/preferences_gen.h:5227
msgid "selection order"
msgstr "seçim tərtibi"

#: ../build/bin/preferences_gen.h:5236
msgid ""
"after applying the above rules, apply the shortcut based on its position in "
