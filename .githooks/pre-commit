#!/bin/bash

# Prints the error message for a path that must not be committed without
# --no-verify, nothing otherwise. A case statement rather than an
# associative array: macOS ships bash 3.2, which has no declare -A.

_protected_path_error()
{
    case "$1" in
        src/external/rawspeed) echo "use --no-verify to change rawspeed" ;;
        src/external/OpenCL) echo "use --no-verify to change OpenCL" ;;
        src/external/libxcf) echo "use --no-verify to change libxcf" ;;
        src/external/whereami) echo "use --no-verify to change whereami" ;;
        src/tests/integration) echo "use --no-verify to change integration" ;;
    esac
}

# Loop over staged files and check for any of the protected paths.
# Filter only added (A), copied (C), modified (M) files

errors=()

for file in $(git diff --staged --name-only --diff-filter=ACM --no-color); do
    error=$(_protected_path_error "${file}")
    if [ -n "${error}" ]; then
        errors+=("${error}")
    fi
done

# Print errors
for error in "${errors[@]}"; do
  echo -e "\033[1;31m${error}\033[0m"
done

# If there is any error, then stop commit creation
if [ ${#errors[@]} -ne 0 ]; then
  exit 1
fi
