# dt-lockcheck rules, as Datalog for lemmalog.  Kept in step with the Python in
# dt-lockcheck.py: both produce the same findings.

rule setup_fn("gui_init").
rule setup_fn("gui_cleanup").
rule setup_fn("gui_reset").

rule touch(M,F,T) :- access(M,F,Fn,_,_), runs_on(M,Fn,T), !setup_fn(Fn).

# "either" is a callback the pipe drives that GTK-thread code also reaches.  It
# counts on both sides, because two calls can run on different threads.
rule may_pipe(M,F) :- touch(M,F,"pipe").
rule may_pipe(M,F) :- touch(M,F,"either").
rule may_gtk(M,F) :- touch(M,F,"gtk").
rule may_gtk(M,F) :- touch(M,F,"either").
rule shared(M,F) :- may_pipe(M,F), may_gtk(M,F).

rule written_late(M,F,T) :- access(M,F,Fn,_,"w"), runs_on(M,Fn,T), !setup_fn(Fn).

# A locked site is evidence of a per-field convention, unless it is bulk
# initialisation, which the extractor marks as "bulk_init".
rule has_discipline(M,F) :- access(M,F,_,"gui_lock",_).
rule has_discipline(M,F) :- access(M,F,_,L,_), L \= "gui_lock", L \= "none", L \= "bulk_init".

rule is_widget(M,F) :- ftype(M,F,T), gtk_type(T).
rule is_pointer(M,F) :- ftype(M,F,T), ptr_type(T).
rule widget_from_pipe(M,F,Fn) :- is_widget(M,F), access(M,F,Fn,_,_), runs_on(M,Fn,"pipe").
rule widget_from_pipe(M,F,Fn) :- is_widget(M,F), access(M,F,Fn,_,_), runs_on(M,Fn,"either").

# The report gives one rule per field, in this order of interest, so each rule
# excludes the ones above it.  The Python side does the same with an if/elif
# cascade.  Among the first four, only widget_from_pipe needs an explicit guard.
# violation and no_lock_share disagree on has_discipline, and discipline_gap
# requires it, so it cannot coincide with no_lock_share either.
rule reported_widget(M,F) :- widget_from_pipe(M,F,_).

rule violation(M,F,Fn) :- has_discipline(M,F), shared(M,F), access(M,F,Fn,"none",_), !setup_fn(Fn), !reported_widget(M,F).
rule no_lock_share(M,F) :- shared(M,F), written_late(M,F,_), !has_discipline(M,F), !reported_widget(M,F).

rule discipline_gap(M,F,Fn) :- has_discipline(M,F), access(M,F,Fn,"none",_), !setup_fn(Fn), !violation(M,F,Fn), !reported_widget(M,F).

# pointer_share is last in the cascade, so unlike the four above it has to
# exclude all of them explicitly instead of relying on a pairwise disagreement.
# It does not ask for an unlocked site, so it reports a shared pointer whose
# every access is locked, and one that is never locked and only read.  A lock
# protects the pointer load, not the object, which the other thread may free
# while the reader uses it.
rule reported_above(M,F) :- reported_widget(M,F).
rule reported_above(M,F) :- violation(M,F,_).
rule reported_above(M,F) :- no_lock_share(M,F).
rule reported_above(M,F) :- discipline_gap(M,F,_).

rule pointer_share(M,F) :- is_pointer(M,F), shared(M,F), !reported_above(M,F).
