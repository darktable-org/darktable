diff --git a/src/tests/unittests/common/test_spektra_pack.c b/src/tests/unittests/common/test_spektra_pack.c
new file mode 100644
index 0000000..16ab3ca
--- /dev/null
+++ b/src/tests/unittests/common/test_spektra_pack.c
@@ -0,0 +1,769 @@
