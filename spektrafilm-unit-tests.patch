 src/tests/unittests/common/CMakeLists.txt     |  22 +
 .../unittests/common/test_spektra_pack.c      | 769 ++++++++++++++++++
 src/tests/unittests/common/test_spektra_sim.c | 581 +++++++++++++
 4 files changed, 1373 insertions(+)
 create mode 100644 src/tests/unittests/common/CMakeLists.txt
 create mode 100644 src/tests/unittests/common/test_spektra_pack.c
 create mode 100644 src/tests/unittests/common/test_spektra_sim.c

